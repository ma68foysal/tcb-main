{%- comment -%}
  Content Freshness Signals for AI Search
  ========================================
  This snippet adds meta tags that signal content freshness to AI search engines.
  AI models prioritize recently updated content.

  Include in theme.liquid head section:
  {%- render 'freshness-meta' -%}
{%- endcomment -%}

{%- assign current_date = 'now' | date: '%Y-%m-%d' -%}

{%- case request.page_type -%}
  {%- when 'product' -%}
    <meta property="article:modified_time" content="{{ product.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
    <meta name="revised" content="{{ product.updated_at | date: '%Y-%m-%d' }}">
  {%- when 'article' -%}
    <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
    <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
    <meta name="revised" content="{{ article.updated_at | date: '%Y-%m-%d' }}">
  {%- when 'collection' -%}
    <meta property="article:modified_time" content="{{ collection.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  {%- when 'page' -%}
    <meta property="article:modified_time" content="{{ page.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  {%- when 'blog' -%}
    <meta property="article:modified_time" content="{{ blog.articles.first.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
{%- endcase -%}

{%- comment -%} Last modified meta for all pages {%- endcomment -%}
<meta name="last-modified" content="{{ current_date }}">
