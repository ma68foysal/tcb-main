    "testimonials_DjKdJg": {
      "type": "testimonials",
      "blocks": {
        "testimonial_DePw6A": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/IMG_7257_823cbf0f-516a-4309-96cb-3b982a54321a.jpg",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Andrés Preschel | Exercise Physiologist, Lifestyle Medicine Author and Podcast Host",
            "show_verified_badge": true,
            "verified_badge_text": "Verified Buyer",
            "title": "",
            "content": "<p>“I’m a big believer in transparency... how you do one thing is how you do everything. The Conscious Bar is no exception; it’s clearly an extremely healthy, truly sustainable and ethically sourced chocolate bar that you can feel REALLY good about all the way through. The chocolate is exquisite, but this brand sets the bar high for so much more than its mere indulgence. Thank you!\"</p>"
          }
        },
        "testimonial_zMTQA3": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/liana.jpg",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Liana Werner-Gray | Certified Nutritionist & Best-Selling Author 'Cancer-Free with Food'",
            "show_verified_badge": true,
            "verified_badge_text": "Verified Buyer",
            "title": "",
            "content": "<p>“The first thing I did when I saw The Conscious Bar chocolate was to look at the ingredients and I must say, wow! A premium chocolate bar, vegan & gently sweetened with organic dates! I was so excited to try it, and as soon as I tasted it I was amazed. The flavors are incredible, very uplifting and you can clearly taste the pure ingredients which are essentially two superfoods and nothing else.<br/></p>"
          }
        },
        "testimonial_TNaBtc": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/test.jpg",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "John Iatrellis | Corporate Executive Chef, Lifehouse Hotels",
            "show_verified_badge": true,
            "verified_badge_text": "Verified Buyer",
            "title": "",
            "content": "<p>\"The Conscious Bar is truly innovating the craft chocolate space. As a Chef we try to speak the language of the foods from the lands in which our journey has allowed us to experience. These guys speak in the most fluent and natural epicurean language with delicious, clean & honest ingredients that fuel the soul and literally give back to mother nature through their commitment to sustainability.\"</p>"
          }
        }
      },
