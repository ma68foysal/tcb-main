    "multi_column_jaRpmw": {
      "type": "multi-column",
      "blocks": {
        "item_FGKt3m": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/website_direct_trade.jpg",
            "column_size": "3",
            "title": "Direct Trade",
            "heading_tag": "h1",
            "content": "<p><strong>Working directly with farmers</strong> enables us to ensure the welfare and success of the entire value chain. This also allows us to provide & market our products responsibility so that our customers can enjoy the experience of indulging in our products while feeling at ease that our farmers are well taken care of. </p>",
            "link_url": "shopify://pages/direct-trade",
            "link_text": "LEARN MORE",
            "link_style": "button",
            "scroll_to_anchor": ""
          }
        },
        "item_fUmkwE": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/website_sustainability.jpg",
            "column_size": "3",
            "title": "Sustainability",
            "heading_tag": "h1",
            "content": "<p>Our packaging is<strong> plastic free</strong>, made entirely with post consumer waste products (<strong>PCW</strong>). Our interior film wrappers and exterior sealing stickers are also <strong>compostable & biodegradable</strong>, made out of eco-friendly materials such as eucalyptus wood pulp obtained from controlled plantations...</p>",
            "link_url": "shopify://pages/sustainability",
            "link_text": "LEARN MORE",
            "link_style": "button",
            "scroll_to_anchor": ""
          }
        },
        "item_ULqRxD": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/website_nourishment.jpg",
            "column_size": "3",
            "title": "Nourishment",
            "heading_tag": "h1",
            "content": "<p>Chocolate can be more than a treat—it can be a powerhouse of nutrition. With <strong>Organic Cacao</strong> and <strong>Organic Dates</strong> as our main ingredients, The Conscious Bar offers indulgence that’s as nourishing as it is delicious – and we have the science to back it up. Let’s dive into the data, shall we?</p>",
            "link_url": "shopify://pages/the-science",
            "link_text": "LEARN MORE",
            "link_style": "button",
            "scroll_to_anchor": ""
          }
        }
      },
      "block_order": [
        "item_FGKt3m",
        "item_fUmkwE",
        "item_ULqRxD"
      ],
