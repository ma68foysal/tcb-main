        "row_P37Ba6": {
          "type": "row",
          "settings": {
            "heading": "Obsessed with Quality",
            "value": "<p>\"Good enough\" isn't in our recipe. Whether it's the code on our website or the cacao in our bars, we sweat the details. We take pride in craftsmanship in everything we do.</p>"
          }
