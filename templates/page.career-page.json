    "rich_text_FKCxWG": {
      "type": "rich-text",
      "blocks": {
        "subheading_deQUkk": {
          "type": "subheading",
          "disabled": true,
          "settings": {
            "text": "Our Cacao’s Journey from the Semuliki Forest"
